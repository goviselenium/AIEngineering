# ==============================================================================
# Agentic Quality Engineering Platform Configuration
# ==============================================================================

# Pluggable LLM Provider: 'ollama' (default) | 'openai' | 'gemini' | 'anthropic'
LLM_PROVIDER=ollama

# Ollama Configuration (Local, Zero-Cost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest
# Alternatives: llama3.2:latest, deepseek-r1:8b

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Model Context Protocol (MCP) Configuration
MCP_SERVER_PORT=8080
MCP_LOG_LEVEL=info

# CI/CD & GitHub Integration
GITHUB_TOKEN=
GITHUB_REPOSITORY=
